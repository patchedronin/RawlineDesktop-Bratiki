+// LoadDirectSample observes the outbound the caller itself will dial.
+func (s *HistoryStorage) LoadDirectSample(member adapter.Outbound) (string, *adapter.URLTestHistory) {
+	if s == nil || member == nil {
+		return "", nil
+	}
+	if _, isGroup := member.(adapter.OutboundGroup); isGroup {
+		return "", nil
+	}
+	tag := member.Tag()
+	return tag, s.LoadURLTestHistory(tag)
+}
+
+// DeleteURLTestHistoryIfCurrent invalidates only the sample observed before the failed attempt.
+func (s *HistoryStorage) DeleteURLTestHistoryIfCurrent(tag string, expected *adapter.URLTestHistory) {
+	if expected == nil {
+		return
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.delayHistory[tag] == expected {
+		delete(s.delayHistory, tag)
+		s.notifyUpdated()
+	}
 }
 
